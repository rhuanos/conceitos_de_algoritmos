programa
{
	
	funcao inicio()
	{
		inteiro ano_nasc, idade, ano_atual = 2026
		
		escreva("Digite o ano do seu nascimento\n")
		
		leia(ano_nasc)

		idade = ano_atual - ano_nasc
		escreva("Sua idade é: \n", idade)
			
	
	}
}
